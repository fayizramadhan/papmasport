<div class="toast" id="toast"></div>

<script>
/* ============================================================
   PAPMA SPORT — App Logic
   ============================================================ */

const $  = (s, el = document) => el.querySelector(s);
const $$ = (s, el = document) => Array.from(el.querySelectorAll(s));

/* ---------- Storage Helper ---------- */
const store = {
  get(key, fallback){
    try{
      const raw = localStorage.getItem(key);
      return raw === null ? fallback : JSON.parse(raw);
    }catch(e){ return fallback; }
  },
  set(key, value){
    try{ localStorage.setItem(key, JSON.stringify(value)); }catch(e){}
  }
};

const KEY_THEME    = 'papma_theme';
const KEY_NOTES    = 'papma_notes';
const KEY_CHECKIN  = 'papma_checkin';

/* ---------- Toast ---------- */
let toastTimer = null;
function toast(msg){
  const el = $('#toast');
  el.textContent = msg;
  el.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => el.classList.remove('show'), 2200);
}

/* ============================================================
   THEME
   ============================================================ */
const SUN_ICON = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v2.5M12 19.5V22M4.2 4.2l1.8 1.8M18 18l1.8 1.8M2 12h2.5M19.5 12H22M4.2 19.8L6 18M18 6l1.8-1.8"/></svg>`;
const MOON_ICON = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>`;

function applyTheme(theme){
  document.documentElement.setAttribute('data-theme', theme);
  store.set(KEY_THEME, theme);
  $('#themeBtn').innerHTML = theme === 'dark' ? SUN_ICON : MOON_ICON;

  const meta = document.querySelector('meta[name="theme-color"]');
  if(meta) meta.setAttribute('content', theme === 'dark' ? '#000000' : '#f2f2f7');
}

const initialTheme = store.get(KEY_THEME, null)
  || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
applyTheme(initialTheme);

$('#themeBtn').addEventListener('click', () => {
  const now = document.documentElement.getAttribute('data-theme');
  applyTheme(now === 'dark' ? 'light' : 'dark');
});

/* ============================================================
   TAB NAVIGATION
   ============================================================ */
$$('.tab').forEach(tab => {
  tab.addEventListener('click', () => {
    $$('.tab').forEach(t => t.classList.remove('active'));
    $$('.view').forEach(v => v.classList.remove('active'));
    tab.classList.add('active');
    $('#view-' + tab.dataset.view).classList.add('active');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
});

/* ============================================================
   AUDIO + HAPTIC
   ============================================================ */
function beep(){
  try{
    const Ctx = window.AudioContext || window.webkitAudioContext;
    if(!Ctx) return;
    const ctx = new Ctx();
    const now = ctx.currentTime;
    [0, 0.24, 0.48].forEach(offset => {
      const osc  = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(920, now + offset);
      gain.gain.setValueAtTime(0.0001, now + offset);
      gain.gain.exponentialRampToValueAtTime(0.32, now + offset + 0.02);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + offset + 0.22);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start(now + offset);
      osc.stop(now + offset + 0.25);
    });
    setTimeout(() => ctx.close(), 1400);
  }catch(e){}
}

function fireSfx(){
  try{
    const Ctx = window.AudioContext || window.webkitAudioContext;
    if(!Ctx) return;
    const ctx = new Ctx();
    const now = ctx.currentTime;

    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(420, now);
    osc.frequency.exponentialRampToValueAtTime(120, now + 0.55);
    gain.gain.setValueAtTime(0.0001, now);
    gain.gain.exponentialRampToValueAtTime(0.22, now + 0.05);
    gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.6);
    osc.connect(gain); gain.connect(ctx.destination);
    osc.start(now); osc.stop(now + 0.65);

    const osc2 = ctx.createOscillator();
    const gain2 = ctx.createGain();
    osc2.type = 'sine';
    osc2.frequency.setValueAtTime(880, now + 0.08);
    osc2.frequency.exponentialRampToValueAtTime(1760, now + 0.4);
    gain2.gain.setValueAtTime(0.0001, now + 0.08);
    gain2.gain.exponentialRampToValueAtTime(0.16, now + 0.12);
    gain2.gain.exponentialRampToValueAtTime(0.0001, now + 0.5);
    osc2.connect(gain2); gain2.connect(ctx.destination);
    osc2.start(now + 0.08); osc2.stop(now + 0.55);

    setTimeout(() => ctx.close(), 1200);
  }catch(e){}
}

function haptic(pattern){
  if(navigator.vibrate) navigator.vibrate(pattern);
}

/* ============================================================
   FIRE / DAILY LOGIN
   ============================================================ */
let checkIn = store.get(KEY_CHECKIN, {
  last: null,
  streak: 0,
  best: 0,
  total: 0,
  history: []
});

function pad2(n){ return String(n).padStart(2, '0'); }

function dateKey(d){
  return `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}`;
}

function todayKey(){
  return dateKey(new Date());
}

function yesterdayKey(){
  const d = new Date();
  d.setDate(d.getDate() - 1);
  return dateKey(d);
}

function saveCheckIn(){
  store.set(KEY_CHECKIN, checkIn);
}

function effectiveStreak(){
  const today = todayKey();
  const yest  = yesterdayKey();
  if(checkIn.last === today) return checkIn.streak;
  if(checkIn.last === yest)  return checkIn.streak;
  return 0;
}

function isCheckedInToday(){
  return checkIn.last === todayKey();
}

function msToMidnight(){
  const now = new Date();
  const midnight = new Date(now);
  midnight.setHours(24, 0, 0, 0);
  return midnight - now;
}

function formatCountdown(ms){
  ms = Math.max(0, ms);
  const totalSec = Math.floor(ms / 1000);
  const h = Math.floor(totalSec / 3600);
  const m = Math.floor((totalSec % 3600) / 60);
  const s = totalSec % 60;
  return `${pad2(h)}:${pad2(m)}:${pad2(s)}`;
}

function renderFire(){
  const btn   = $('#fireBtn');
  const wrap  = $('#fireWrap');
  const card  = $('#fireCard');
  const done  = isCheckedInToday();

  if(done){
    btn.classList.add('locked');
    wrap.classList.add('locked');
    card.classList.remove('burning');
  }else{
    btn.classList.remove('locked');
    wrap.classList.remove('locked');
    card.classList.add('burning');
  }

  const eff = effectiveStreak();
  $('#streakNum').textContent = eff;
  $('#totalNum').textContent  = checkIn.total || 0;
  $('#bestNum').textContent   = Math.max(checkIn.best || 0, eff);

  const sub = $('#fireSub');
  if(done){
    const left = msToMidnight();
    sub.innerHTML = `Api menyala! Kembali dalam <b>${formatCountdown(left)}</b>`;
  }else{
    if(eff > 0){
      sub.textContent = `Lanjutkan streak ${eff} harimu 🔥`;
    }else{
      sub.textContent = 'Tap untuk menyalakan api hari ini';
    }
  }

  const cal = $('#fireCalendar');
  const today = new Date();
  let html = '';
  for(let i = 6; i >= 0; i--){
    const d = new Date(today);
    d.setDate(d.getDate() - i);
    const key   = dateKey(d);
    const act   = checkIn.history.includes(key);
    const isNow = i === 0;
    const label = d.toLocaleDateString('id-ID', { weekday: 'short' }).slice(0, 3);
    html += `
      <div class="cal-day ${act ? 'active' : ''} ${isNow ? 'today' : ''}">
        <div class="cal-dot">${act ? '🔥' : ''}</div>
        <span>${label}</span>
      </div>`;
  }
  cal.innerHTML = html;
}

$('#fireBtn').addEventListener('click', () => {
  if(isCheckedInToday()){
    toast('Sudah absen hari ini — kembali besok!');
    haptic(40);
    return;
  }

  const today = todayKey();
  const yest  = yesterdayKey();

  if(checkIn.last === yest){
    checkIn.streak = (checkIn.streak || 0) + 1;
  }else{
    checkIn.streak = 1;
  }

  checkIn.total = (checkIn.total || 0) + 1;
  checkIn.last = today;

  if(!Array.isArray(checkIn.history)) checkIn.history = [];
  if(!checkIn.history.includes(today)) checkIn.history.unshift(today);
  if(checkIn.history.length > 60) checkIn.history.length = 60;

  if(checkIn.streak > (checkIn.best || 0)){
    checkIn.best = checkIn.streak;
  }

  saveCheckIn();

  fireSfx();
  haptic([60, 40, 60, 40, 180]);
  toast(`🔥 Streak ${checkIn.streak} hari! Api menyala.`);

  renderFire();
});

let fireTickerId = null;
function startFireTicker(){
  if(fireTickerId) clearInterval(fireTickerId);
  fireTickerId = setInterval(() => {
    if(isCheckedInToday()){
      const sub = $('#fireSub');
      if(sub && sub.querySelector('b')){
        sub.querySelector('b').textContent = formatCountdown(msToMidnight());
      }
    }else{
      if($('#fireBtn').classList.contains('locked')){
        renderFire();
        if(checkIn.total > 0){
          setTimeout(() => toast('🌅 Hari baru! Absen lagi yuk.'), 600);
        }
      }
    }
  }, 1000);
}

/* ============================================================
   TIMER
   ============================================================ */
const RING_CIRC = 678.58;

const timer = {
  total: 0,
  remaining: 0,
  running: false,
  endAt: 0,
  raf: null,
  finished: false
};

const $tH = $('#tH'), $tM = $('#tM'), $tS = $('#tS');
const $timerDisplay = $('#timerDisplay');
const $timerLabel   = $('#timerLabel');
const $ringFg       = $('#ringFg');
const $ringWrap     = $('#ringWrap');
const $timerStart   = $('#timerStart');
const $timeInputs   = $('#timeInputs');

function readInputs(){
  const h = Math.max(0, Math.min(99, parseInt($tH.value) || 0));
  const m = Math.max(0, Math.min(59, parseInt($tM.value) || 0));
  const s = Math.max(0, Math.min(59, parseInt($tS.value) || 0));
  return ((h * 3600) + (m * 60) + s) * 1000;
}

function formatTimer(ms){
  ms = Math.max(0, ms);
  const totalSec = Math.ceil(ms / 1000);
  const h = Math.floor(totalSec / 3600);
  const m = Math.floor((totalSec % 3600) / 60);
  const s = totalSec % 60;

  if(h > 0){
    return `${h}:${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
  }
  return `${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
}

function renderTimer(){
  $timerDisplay.textContent = formatTimer(timer.remaining);

  const progress = timer.total > 0 ? Math.max(0, Math.min(1, timer.remaining / timer.total)) : 0;
  $ringFg.style.strokeDashoffset = String(RING_CIRC * (1 - progress));

  if(timer.running){
    $timerLabel.textContent = 'Berjalan';
    $timerStart.textContent = 'Jeda';
    $timerStart.classList.add('stop');
    $timeInputs.style.display = 'none';
    $('#presetChips').style.display = 'none';
  }else{
    $timerStart.textContent = timer.remaining > 0 && timer.remaining < timer.total ? 'Lanjut' : 'Mulai';
    $timerStart.classList.remove('stop');
    $timeInputs.style.display = 'flex';
    $('#presetChips').style.display = 'flex';
    if(timer.finished){
      $timerLabel.textContent = 'Selesai!';
    }else if(timer.remaining > 0 && timer.remaining < timer.total){
      $timerLabel.textContent = 'Dijeda';
    }else{
      $timerLabel.textContent = 'Siap';
    }
  }
}

function syncFromInputs(){
  if(timer.running) return;
  if(timer.remaining > 0 && timer.remaining < timer.total) return;
  timer.total = readInputs();
  timer.remaining = timer.total;
  timer.finished = false;
  $ringWrap.classList.remove('finished');
  renderTimer();
}

[$tH, $tM, $tS].forEach(input => {
  input.addEventListener('input', () => {
    if(input.value.length > 2) input.value = input.value.slice(0, 2);
    syncFromInputs();
  });
  input.addEventListener('blur', () => {
    const max = input === $tH ? 99 : 59;
    let v = parseInt(input.value) || 0;
    v = Math.max(0, Math.min(max, v));
    input.value = String(v);
    syncFromInputs();
  });
});

$$('#presetChips .chip').forEach(chip => {
  chip.addEventListener('click', () => {
    if(timer.running) return;
    const sec = parseInt(chip.dataset.sec);
    $tH.value = String(Math.floor(sec / 3600));
    $tM.value = String(Math.floor((sec % 3600) / 60));
    $tS.value = String(sec % 60);
    timer.total = sec * 1000;
    timer.remaining = timer.total;
    timer.finished = false;
    $ringWrap.classList.remove('finished');
    renderTimer();
    haptic(10);
  });
});

function timerTick(){
  if(!timer.running) return;
  timer.remaining = timer.endAt - Date.now();

  if(timer.remaining <= 0){
    timer.remaining = 0;
    timer.running = false;
    timer.finished = true;
    cancelAnimationFrame(timer.raf);
    $ringWrap.classList.add('finished');
    renderTimer();
    beep();
    haptic([220, 100, 220, 100, 320]);
    toast('⏰ Waktu habis!');
    return;
  }

  renderTimer();
  timer.raf = requestAnimationFrame(timerTick);
}

$timerStart.addEventListener('click', () => {
  if(timer.running){
    timer.running = false;
    cancelAnimationFrame(timer.raf);
    renderTimer();
    haptic(15);
    return;
  }

  if(timer.remaining > 0 && timer.remaining < timer.total && !timer.finished){
    timer.endAt = Date.now() + timer.remaining;
    timer.running = true;
    timer.raf = requestAnimationFrame(timerTick);
    renderTimer();
    haptic(15);
    return;
  }

  timer.total = readInputs();
  timer.remaining = timer.total;

  if(timer.total <= 0){
    toast('Atur durasi terlebih dahulu');
    haptic(40);
    return;
  }

  timer.finished = false;
  $ringWrap.classList.remove('finished');
  timer.endAt = Date.now() + timer.total;
  timer.running = true;
  timer.raf = requestAnimationFrame(timerTick);
  renderTimer();
  haptic(20);
});

$('#timerReset').addEventListener('click', () => {
  timer.running = false;
  cancelAnimationFrame(timer.raf);
  timer.finished = false;
  timer.total = readInputs();
  timer.remaining = timer.total;
  $ringWrap.classList.remove('finished');
  renderTimer();
  haptic(15);
});

/* ============================================================
   STOPWATCH
   ============================================================ */
const sw = {
  running: false,
  elapsed: 0,
  startAt: 0,
  raf: null,
  laps: []
};

const $swDisplay = $('#swDisplay');
const $swStart   = $('#swStart');
const $swLap     = $('#swLap');

function formatSW(ms){
  const cs = Math.floor(ms / 10) % 100;
  const s  = Math.floor(ms / 1000) % 60;
  const m  = Math.floor(ms / 60000);
  return {
    main: `${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`,
    ms: `,${String(cs).padStart(2,'0')}`
  };
}

function renderSW(){
  const f = formatSW(sw.elapsed);
  $swDisplay.innerHTML = `${f.main}<span class="sw-ms">${f.ms}</span>`;
}

function swTick(){
  if(!sw.running) return;
  sw.elapsed = Date.now() - sw.startAt;
  renderSW();
  sw.raf = requestAnimationFrame(swTick);
}

$swStart.addEventListener('click', () => {
  if(sw.running){
    sw.running = false;
    cancelAnimationFrame(sw.raf);
    $swStart.textContent = 'Lanjut';
    $swStart.classList.remove('stop');
    $('#swLabel').textContent = 'Dijeda';
    haptic(15);
  }else{
    sw.startAt = Date.now() - sw.elapsed;
    sw.running = true;
    sw.raf = requestAnimationFrame(swTick);
    $swStart.textContent = 'Jeda';
    $swStart.classList.add('stop');
    $('#swLabel').textContent = 'Berjalan';
    haptic(15);
  }
});

$swLap.addEventListener('click', () => {
  if(sw.elapsed === 0){
    toast('Mulai stopwatch terlebih dahulu');
    return;
  }

  const prevTotal = sw.laps.length ? sw.laps[sw.laps.length - 1].total : 0;
  const split = sw.elapsed - prevTotal;

  sw.laps.push({ total: sw.elapsed, split });
  renderLaps();
  haptic(12);
});

function renderLaps(){
  const list = $('#lapList');

  if(sw.laps.length === 0){
    list.innerHTML = `
      <div class="empty" id="lapEmpty">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2.5"/><path d="M9 2h6"/>
        </svg>
        <p><strong>Belum ada lap</strong>Tekan "Lap" saat stopwatch berjalan.</p>
      </div>`;
    return;
  }

  const fastest = Math.min(...sw.laps.map(l => l.split));
  const slowest = Math.max(...sw.laps.map(l => l.split));

  let html = '';
  for(let i = sw.laps.length - 1; i >= 0; i--){
    const lap = sw.laps[i];
    const fSplit = formatSW(lap.split);
    const fTotal = formatSW(lap.total);

    let color = 'var(--text2)';
    if(sw.laps.length > 1){
      if(lap.split === fastest) color = 'var(--green)';
      else if(lap.split === slowest) color = 'var(--red)';
    }

    html += `
      <div class="list-row">
        <div class="row-icon blue" style="background:var(--fill);color:${color}">
          <span style="font-size:13px;font-weight:800">${i + 1}</span>
        </div>
        <div class="row-body">
          <p class="row-title">Lap ${i + 1}</p>
          <p class="row-sub" style="color:${color}">${fSplit.main}${fSplit.ms}</p>
        </div>
        <div class="row-value">${fTotal.main}${fTotal.ms}</div>
      </div>`;
  }

  list.innerHTML = html;
}

$('#swSave').addEventListener('click', () => {
  if(sw.elapsed < 100 && sw.laps.length === 0){
    toast('Belum ada data stopwatch');
    return;
  }
  if(!confirm('Reset stopwatch?')) return;

  sw.running = false;
  cancelAnimationFrame(sw.raf);
  sw.elapsed = 0;
  sw.laps = [];
  $swStart.textContent = 'Mulai';
  $swStart.classList.remove('stop');
  $('#swLabel').textContent = 'Stopwatch';
  renderSW();
  renderLaps();
  haptic(20);
  toast('Stopwatch direset');
});

$swDisplay.addEventListener('dblclick', () => {
  if(sw.elapsed < 100 && sw.laps.length === 0) return;
  if(!confirm('Reset stopwatch?')) return;
  sw.running = false;
  cancelAnimationFrame(sw.raf);
  sw.elapsed = 0;
  sw.laps = [];
  $swStart.textContent = 'Mulai';
  $swStart.classList.remove('stop');
  $('#swLabel').textContent = 'Stopwatch';
  renderSW();
  renderLaps();
  haptic(20);
});

/* ============================================================
   NOTES
   ============================================================ */
let notes = store.get(KEY_NOTES, []);
let editingNoteId = null;

const $overlay   = $('#overlay');
const $noteSheet = $('#noteSheet');

function openSheet(note){
  editingNoteId = note ? note.id : null;
  $('#sheetTitle').textContent = note ? 'Edit Catatan' : 'Catatan Baru';
  $('#noteTitle').value = note ? note.title : '';
  $('#noteBody').value  = note ? note.body  : '';

  $overlay.classList.add('show');
  $noteSheet.classList.add('show');
  document.body.style.overflow = 'hidden';

  setTimeout(() => $('#noteTitle').focus(), 350);
}

function closeSheet(){
  $overlay.classList.remove('show');
  $noteSheet.classList.remove('show');
  document.body.style.overflow = '';
  editingNoteId = null;
}

$('#noteAdd').addEventListener('click', () => openSheet(null));
$('#noteCancel').addEventListener('click', closeSheet);
$overlay.addEventListener('click', closeSheet);

$('#noteSave').addEventListener('click', () => {
  const title = $('#noteTitle').value.trim();
  const body  = $('#noteBody').value.trim();

  if(!title && !body){
    toast('Catatan masih kosong');
    return;
  }

  const finalTitle = title || 'Tanpa Judul';

  if(editingNoteId){
    const note = notes.find(n => n.id === editingNoteId);
    if(note){
      note.title = finalTitle;
      note.body  = body;
      note.updated = Date.now();
    }
    toast('✓ Catatan diperbarui');
  }else{
    notes.unshift({
      id: Date.now() + '-' + Math.random().toString(36).slice(2, 7),
      title: finalTitle,
      body,
      created: Date.now(),
      updated: Date.now()
    });
    toast('✓ Catatan disimpan');
  }

  saveNotes();
  renderNotes();
  closeSheet();
  haptic(20);
});

function saveNotes(){
  store.set(KEY_NOTES, notes);
}

function escapeHtml(str){
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function renderNotes(){
  const wrap = $('#noteList');

  if(notes.length === 0){
    wrap.innerHTML = `
      <div class="list">
        <div class="empty">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 3h9l5 5v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"/>
            <path d="M14 3v6h6"/><path d="M9 13h6"/><path d="M9 17h4"/>
          </svg>
          <p><strong>Belum ada catatan</strong>Simpan program latihan, target, atau evaluasi performa kamu di sini.</p>
        </div>
      </div>`;
    return;
  }

  const sorted = [...notes].sort((a, b) => (b.updated || b.created) - (a.updated || a.created));

  wrap.innerHTML = sorted.map(note => {
    const d = new Date(note.updated || note.created);
    const stamp = d.toLocaleDateString('id-ID', { day:'numeric', month:'short', year:'numeric' }) +
                  ' • ' +
                  d.toLocaleTimeString('id-ID', { hour:'2-digit', minute:'2-digit' });

    return `
      <div class="note-card" data-id="${note.id}">
        <h3>${escapeHtml(note.title)}</h3>
        ${note.body ? `<p>${escapeHtml(note.body)}</p>` : ''}
        <div class="note-meta">
          <span>${stamp}</span>
          <button data-del="${note.id}">Hapus</button>
        </div>
      </div>`;
  }).join('');

  $$('.note-card', wrap).forEach(card => {
    card.addEventListener('click', e => {
      if(e.target.dataset.del) return;
      const note = notes.find(n => n.id === card.dataset.id);
      if(note) openSheet(note);
    });
  });

  $$('[data-del]', wrap).forEach(btn => {
    btn.addEventListener('click', e => {
      e.stopPropagation();
      const id = btn.dataset.del;
      if(confirm('Hapus catatan ini?')){
        notes = notes.filter(n => n.id !== id);
        saveNotes();
        renderNotes();
        toast('Catatan dihapus');
        haptic(20);
      }
    });
  });
}

/* ============================================================
   INIT
   ============================================================ */
function init(){
  timer.total = readInputs();
  timer.remaining = timer.total;
  renderTimer();

  renderSW();
  renderLaps();
  renderNotes();
  renderFire();
  startFireTicker();

  let lastTouch = 0;
  document.addEventListener('touchend', e => {
    const now = Date.now();
    if(now - lastTouch <= 300) e.preventDefault();
    lastTouch = now;
  }, { passive: false });
}

init();

window.addEventListener('beforeunload', () => {
  saveNotes();
  saveCheckIn();
});
</script>
