<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, maximum-scale=1.0, user-scalable=no" />
<meta name="theme-color" content="#f2f2f7" />
<title>PAPMA SPORT</title>

<!-- ================= FAVICON ================= -->
<link rel="icon" type="image/png" href="logo.png" />
<link rel="apple-touch-icon" href="logo.png" />

<style>
/* ============================================================
   PAPMA SPORT — iOS Style Sport Timer
   ============================================================ */

:root{
  --bg:            #f2f2f7;
  --nav-bg:        rgba(242,242,247,0.78);
  --elev:          #ffffff;
  --elev2:         #ffffff;
  --text:          #000000;
  --text2:         #8e8e93;
  --text3:         #c7c7cc;
  --sep:           rgba(60,60,67,0.13);
  --fill:          rgba(120,120,128,0.12);
  --fill2:         rgba(120,120,128,0.20);
  --blue:          #007aff;
  --green:         #34c759;
  --red:           #ff3b30;
  --orange:        #ff9500;
  --yellow:        #ffd60a;
  --purple:        #af52de;
  --shadow:        0 8px 30px rgba(0,0,0,0.08);
  --radius:        20px;
}

[data-theme="dark"]{
  --bg:            #000000;
  --nav-bg:        rgba(0,0,0,0.72);
  --elev:          #1c1c1e;
  --elev2:         #2c2c2e;
  --text:          #ffffff;
  --text2:         #8e8e93;
  --text3:         #48484a;
  --sep:           rgba(84,84,88,0.65);
  --fill:          rgba(120,120,128,0.24);
  --fill2:         rgba(120,120,128,0.36);
  --shadow:        0 8px 30px rgba(0,0,0,0.5);
}

*{ box-sizing:border-box; -webkit-tap-highlight-color:transparent; }

html,body{ margin:0; padding:0; height:100%; }

body{
  font-family:-apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display",
              "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  background:var(--bg);
  color:var(--text);
  min-height:100vh;
  overflow-x:hidden;
  overscroll-behavior-y:none;
  transition:background .35s ease, color .35s ease;
  -webkit-font-smoothing:antialiased;
}

/* ---------- NAV BAR ---------- */
.nav{
  position:sticky; top:0; z-index:60;
  backdrop-filter:saturate(180%) blur(20px);
  -webkit-backdrop-filter:saturate(180%) blur(20px);
  background:var(--nav-bg);
  border-bottom:.5px solid var(--sep);
  transition:background .35s ease, border-color .35s ease;
}
.nav-inner{
  max-width:640px; margin:0 auto;
  display:flex; align-items:center; justify-content:space-between;
  padding:10px 18px;
  padding-top:calc(10px + env(safe-area-inset-top));
}
.brand{ display:flex; align-items:center; gap:10px; }

/* --- LOGO --- */
.logo{
  width:38px; height:38px; border-radius:12px;
  overflow:hidden; display:grid; place-items:center;
  background:#ffffff;
  box-shadow: 0 0 16px rgba(0, 200, 255, 0.7);
  border: 1px solid rgba(0, 200, 255, 0.3);
}
.logo img{
  width:100%; height:100%; object-fit:cover;
}

.brand h1{ margin:0; font-size:17px; font-weight:700; letter-spacing:.6px; }
.brand h1 span{ color:var(--blue); }

.icon-btn{
  width:38px; height:38px; border-radius:50%;
  border:none; background:var(--fill); color:var(--text);
  display:grid; place-items:center; cursor:pointer;
  transition:transform .18s ease, background .2s ease;
}
.icon-btn:active{ transform:scale(.9); background:var(--fill2); }
.icon-btn svg{ width:19px; height:19px; }

/* ---------- MAIN ---------- */
main{
  max-width:640px; margin:0 auto;
  padding:20px 16px calc(110px + env(safe-area-inset-bottom));
}
.view{ display:none; animation:fadeUp .35s cubic-bezier(.22,1,.36,1); }
.view.active{ display:block; }

@keyframes fadeUp{
  from{ opacity:0; transform:translateY(10px); }
  to{ opacity:1; transform:translateY(0); }
}

.section-title{
  font-size:13px; font-weight:600; letter-spacing:.5px;
  color:var(--text2); text-transform:uppercase;
  margin:0 0 10px 6px;
}

/* ---------- CARD ---------- */
.card{
  background:var(--elev);
  border-radius:var(--radius);
  padding:22px 18px;
  margin-bottom:16px;
  box-shadow:var(--shadow);
  transition:background .35s ease, box-shadow .35s ease;
}

/* ---------- RING TIMER ---------- */
.ring-wrap{
  position:relative;
  width:250px; height:250px;
  margin:6px auto 20px;
}
.ring{ width:100%; height:100%; transform:rotate(-90deg); }
.ring circle{ fill:none; stroke-width:11; stroke-linecap:round; }
.ring .ring-bg{ stroke:var(--fill); }
.ring .ring-fg{
  stroke:var(--blue);
  stroke-dasharray:678.58;
  stroke-dashoffset:0;
  transition:stroke-dashoffset .12s linear, stroke .3s ease;
}
.ring.finished .ring-fg{ stroke:var(--red); }

.ring-center{
  position:absolute; inset:0;
  display:flex; flex-direction:column;
  align-items:center; justify-content:center;
  gap:4px;
}
.time-display{
  font-size:46px; font-weight:200; letter-spacing:-1.5px;
  font-variant-numeric:tabular-nums;
  line-height:1;
}
.time-sub{
  font-size:12px; font-weight:600; letter-spacing:1.4px;
  text-transform:uppercase; color:var(--text2);
}

/* ---------- INPUT WAKTU ---------- */
.time-inputs{
  display:flex; align-items:center; justify-content:center;
  gap:8px; margin-bottom:18px;
}
.ti{ display:flex; flex-direction:column; align-items:center; gap:6px; flex:1; max-width:96px; }
.ti input{
  width:100%; text-align:center;
  font-size:30px; font-weight:300; font-variant-numeric:tabular-nums;
  padding:10px 4px;
  border-radius:14px; border:.5px solid var(--sep);
  background:var(--fill); color:var(--text);
  outline:none;
  transition:border-color .2s ease, background .2s ease;
  -moz-appearance:textfield;
}
.ti input::-webkit-outer-spin-button,
.ti input::-webkit-inner-spin-button{ -webkit-appearance:none; margin:0; }
.ti input:focus{ border-color:var(--blue); background:var(--elev2); }
.ti label{ font-size:11px; font-weight:600; color:var(--text2); letter-spacing:.8px; text-transform:uppercase; }
.ti-colon{ font-size:26px; font-weight:300; color:var(--text3); padding-bottom:22px; }

/* ---------- PRESET CHIPS ---------- */
.chips{
  display:flex; gap:8px; overflow-x:auto;
  padding:2px 2px 14px; scrollbar-width:none;
}
.chips::-webkit-scrollbar{ display:none; }
.chip{
  flex:0 0 auto;
  padding:9px 16px; border-radius:999px;
  border:.5px solid var(--sep);
  background:var(--fill); color:var(--text);
  font-size:14px; font-weight:600; cursor:pointer;
  transition:transform .15s ease, background .2s ease;
}
.chip:active{ transform:scale(.94); background:var(--fill2); }

/* ---------- BUTTONS ---------- */
.controls{ display:flex; gap:10px; justify-content:center; align-items:center; }
.btn{
  border:none; cursor:pointer; font-family:inherit;
  font-size:16px; font-weight:600;
  padding:14px 26px; border-radius:999px;
  transition:transform .15s ease, opacity .2s ease, background .25s ease;
  display:inline-flex; align-items:center; justify-content:center; gap:8px;
}
.btn:active{ transform:scale(.95); opacity:.85; }
.btn-primary{ background:var(--blue); color:#fff; box-shadow:0 6px 18px rgba(0,122,255,.32); }
.btn-primary.stop{ background:var(--orange); box-shadow:0 6px 18px rgba(255,149,0,.32); }
.btn-secondary{ background:var(--fill); color:var(--text); }
.btn-ghost{ background:transparent; color:var(--blue); padding:14px 18px; }
.btn-block{ width:100%; }

/* ---------- STOPWATCH ---------- */
.sw-display{
  text-align:center;
  font-size:52px; font-weight:200; letter-spacing:-2px;
  font-variant-numeric:tabular-nums;
  padding:14px 0 6px;
}
.sw-ms{ font-size:30px; color:var(--text2); }
.sw-label{
  text-align:center; font-size:12px; font-weight:600;
  letter-spacing:1.4px; text-transform:uppercase; color:var(--text2);
  margin-bottom:18px;
}

/* ---------- LIST ---------- */
.list{ background:var(--elev); border-radius:var(--radius); overflow:hidden; box-shadow:var(--shadow); }
.list-row{
  display:flex; align-items:center; gap:12px;
  padding:14px 16px;
  border-bottom:.5px solid var(--sep);
  transition:background .2s ease;
}
.list-row:last-child{ border-bottom:none; }
.list-row:active{ background:var(--fill); }
.row-icon{
  width:38px; height:38px; border-radius:11px; flex:0 0 auto;
  display:grid; place-items:center; color:#fff;
}
.row-icon svg{ width:19px; height:19px; }
.row-icon.blue{ background:linear-gradient(145deg,#007aff,#4facfe); }
.row-body{ flex:1; min-width:0; }
.row-title{ font-size:15px; font-weight:600; margin:0 0 2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.row-sub{ font-size:13px; color:var(--text2); margin:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.row-value{ font-size:15px; font-weight:600; font-variant-numeric:tabular-nums; color:var(--text2); flex:0 0 auto; }

/* ---------- NOTES ---------- */
.note-card{
  background:var(--elev); border-radius:var(--radius);
  padding:16px; margin-bottom:12px;
  box-shadow:var(--shadow);
  border-left:4px solid var(--blue);
  cursor:pointer;
  transition:transform .18s ease;
  animation:fadeUp .3s ease;
}
.note-card:active{ transform:scale(.985); }
.note-card h3{ margin:0 0 6px; font-size:16px; font-weight:700; }
.note-card p{
  margin:0; font-size:14px; color:var(--text2); line-height:1.45;
  display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden;
  white-space:pre-wrap; word-break:break-word;
}
.note-meta{
  margin-top:10px; font-size:11px; color:var(--text3);
  letter-spacing:.4px; display:flex; justify-content:space-between; align-items:center;
}
.note-meta button{
  border:none; background:transparent; color:var(--red);
  font-size:12px; font-weight:600; cursor:pointer; font-family:inherit; padding:4px 0;
}

/* ---------- EMPTY STATE ---------- */
.empty{ text-align:center; padding:48px 24px; color:var(--text2); }
.empty svg{ width:52px; height:52px; opacity:.35; margin-bottom:14px; }
.empty p{ margin:0; font-size:14px; line-height:1.5; }
.empty strong{ display:block; font-size:16px; color:var(--text); margin-bottom:6px; }

/* ---------- TAB BAR ---------- */
.tabbar{
  position:fixed; left:0; right:0; bottom:0; z-index:60;
  backdrop-filter:saturate(180%) blur(20px);
  -webkit-backdrop-filter:saturate(180%) blur(20px);
  background:var(--nav-bg);
  border-top:.5px solid var(--sep);
  padding-bottom:env(safe-area-inset-bottom);
  transition:background .35s ease, border-color .35s ease;
}
.tabbar-inner{ max-width:640px; margin:0 auto; display:flex; }
.tab{
  flex:1; border:none; background:transparent; cursor:pointer;
  padding:9px 4px 10px;
  display:flex; flex-direction:column; align-items:center; gap:3px;
  color:var(--text2); font-family:inherit;
  font-size:10px; font-weight:600; letter-spacing:.2s;
  transition:color .2s ease, transform .15s ease;
}
.tab:active{ transform:scale(.92); }
.tab svg{ width:24px; height:24px; }
.tab.active{ color:var(--blue); }

/* ---------- SHEET (MODAL) ---------- */
.overlay{
  position:fixed; inset:0; z-index:80;
  background:rgba(0,0,0,.4);
  backdrop-filter:blur(4px);
  -webkit-backdrop-filter:blur(4px);
  opacity:0; pointer-events:none;
  transition:opacity .3s ease;
}
.overlay.show{ opacity:1; pointer-events:auto; }

.sheet{
  position:fixed; left:0; right:0; bottom:0; z-index:90;
  background:var(--bg);
  border-radius:22px 22px 0 0;
  padding:10px 16px calc(20px + env(safe-area-inset-bottom));
  max-width:640px; margin:0 auto;
  transform:translateY(110%);
  transition:transform .4s cubic-bezier(.22,1,.36,1);
  max-height:88vh; overflow-y:auto;
}
.sheet.show{ transform:translateY(0); }
.sheet-handle{ width:38px; height:5px; border-radius:3px; background:var(--text3); margin:0 auto 14px; }
.sheet h2{ margin:0 0 14px; font-size:20px; font-weight:700; text-align:center; }
.field{ margin-bottom:12px; }
.field label{
  display:block; font-size:12px; font-weight:600; color:var(--text2);
  text-transform:uppercase; letter-spacing:.6px; margin:0 0 6px 4px;
}
.field input, .field textarea{
  width:100%; font-family:inherit; font-size:16px;
  padding:13px 14px; border-radius:14px;
  border:.5px solid var(--sep);
  background:var(--elev); color:var(--text);
  outline:none; resize:vertical;
  transition:border-color .2s ease;
}
.field input:focus, .field textarea:focus{ border-color:var(--blue); }
.field textarea{ min-height:140px; line-height:1.5; }
.sheet-actions{ display:flex; gap:10px; margin-top:16px; }

/* ---------- TOAST ---------- */
.toast{
  position:fixed; left:50%; bottom:calc(110px + env(safe-area-inset-bottom));
  transform:translate(-50%, 20px);
  background:rgba(30,30,32,.94);
  color:#fff; font-size:14px; font-weight:600;
  padding:11px 20px; border-radius:999px;
  z-index:120; opacity:0; pointer-events:none;
  transition:opacity .28s ease, transform .28s ease;
  backdrop-filter:blur(10px);
  max-width:88vw; text-align:center;
}
.toast.show{ opacity:1; transform:translate(-50%, 0); }

/* ---------- STATS ---------- */
.stats{ display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin-bottom:16px; }
.stat{
  background:var(--elev); border-radius:16px; padding:14px 10px;
  text-align:center; box-shadow:var(--shadow);
}
.stat b{ display:block; font-size:22px; font-weight:700; font-variant-numeric:tabular-nums; margin-bottom:2px; }
.stat span{ font-size:10px; font-weight:600; color:var(--text2); text-transform:uppercase; letter-spacing:.5px; }

/* ============================================================
   FIRE / DAILY LOGIN
   ============================================================ */
.fire-card{
  background:var(--elev);
  border-radius:var(--radius);
  padding:34px 20px 24px;
  margin-bottom:16px;
  box-shadow:var(--shadow);
  display:flex; flex-direction:column; align-items:center;
  position:relative; overflow:hidden;
  transition:background .35s ease;
}

.fire-card::before{
  content:'';
  position:absolute;
  top:-40%; left:50%;
  width:380px; height:380px;
  transform:translateX(-50%);
  background:radial-gradient(circle, rgba(255,149,0,.18) 0%, rgba(255,59,48,.06) 40%, transparent 70%);
  pointer-events:none;
  opacity:0;
  transition:opacity .5s ease;
}
.fire-card.burning::before{ opacity:1; }

.fire-btn-wrap{
  position:relative;
  width:230px; height:230px;
  display:grid; place-items:center;
  margin-bottom:20px;
}

.fire-btn{
  position:relative;
  width:190px; height:190px;
  border-radius:50%;
  border:none;
  cursor:pointer;
  background:
    radial-gradient(circle at 50% 30%, rgba(255,255,255,.35) 0%, transparent 55%),
    linear-gradient(180deg, #ffd60a 0%, #ff9500 48%, #ff3b30 100%);
  box-shadow:
    0 22px 50px rgba(255, 59, 48, .42),
    0 10px 30px rgba(255, 149, 0, .35),
    inset 0 -12px 32px rgba(255, 59, 48, .55),
    inset 0 12px 30px rgba(255, 214, 10, .5);
  display:grid; place-items:center;
  transition:transform .22s cubic-bezier(.22,1,.36,1),
             box-shadow .35s ease,
             filter .35s ease;
  z-index:2;
  animation:firePulse 2.6s ease-in-out infinite;
  overflow:visible;
}

.fire-btn::after{
  content:'';
  position:absolute;
  inset:-16px;
  border-radius:50%;
  background:radial-gradient(circle, rgba(255,149,0,.35) 0%, transparent 68%);
  z-index:-1;
  animation:fireGlow 2.6s ease-in-out infinite;
  pointer-events:none;
}

.fire-btn:active{ transform:scale(.95); }

.fire-btn .flame-svg{
  width:52%;
  height:58%;
  position:relative;
  z-index:3;
  filter: drop-shadow(0 0 12px rgba(255,214,10,.85))
          drop-shadow(0 4px 8px rgba(255,59,48,.55));
  animation:flameFlicker 1.4s ease-in-out infinite alternate;
  transform-origin:50% 90%;
}

.fire-btn.locked{
  filter: grayscale(.65) brightness(.72);
  animation:none;
  cursor:default;
  box-shadow:
    0 8px 22px rgba(0,0,0,.18),
    inset 0 -8px 20px rgba(0,0,0,.22);
}
.fire-btn.locked::after{ display:none; }
.fire-btn.locked .flame-svg{ animation:none; filter:drop-shadow(0 2px 4px rgba(0,0,0,.3)); }

@keyframes firePulse{
  0%, 100%{ transform:scale(1); }
  50%     { transform:scale(1.035); }
}
@keyframes fireGlow{
  0%, 100%{ transform:scale(1);   opacity:.85; }
  50%     { transform:scale(1.18); opacity:1;   }
}
@keyframes flameFlicker{
  0%  { transform:scaleY(1)    rotate(-2deg); }
  40% { transform:scaleY(1.05) rotate(1deg);  }
  70% { transform:scaleY(1.02) rotate(-1deg); }
  100%{ transform:scaleY(1.08) rotate(1.5deg);}
}

.fire-sparks{
  position:absolute; inset:0;
  pointer-events:none;
  overflow:visible;
  z-index:1;
}
.spark{
  position:absolute;
  left:var(--x);
  bottom:28%;
  width:6px; height:6px;
  border-radius:50%;
  background:radial-gradient(circle, #fff7c2 0%, #ffd60a 40%, #ff9500 100%);
  box-shadow:0 0 8px #ff9500, 0 0 16px rgba(255,59,48,.7);
  animation:sparkRise 3.2s ease-out infinite;
  animation-delay:var(--d);
  opacity:0;
}
.fire-btn.locked ~ .fire-sparks .spark,
.fire-btn-wrap.locked .spark{
  animation-play-state:paused;
  opacity:0 !important;
}

@keyframes sparkRise{
  0%  { transform:translateY(0)    scale(.4); opacity:0; }
  18% { transform:translateY(-20px) scale(1); opacity:1; }
  70% { opacity:.7; }
  100%{ transform:translateY(-150px) scale(1.3); opacity:0; }
}

.fire-title{
  font-size:22px; font-weight:800; letter-spacing:-.3px;
  margin:0 0 6px; text-align:center;
  background:linear-gradient(90deg, #ff9500, #ff3b30);
  -webkit-background-clip:text; background-clip:text;
  -webkit-text-fill-color:transparent;
}
.fire-sub{
  font-size:13.5px; color:var(--text2);
  margin:0 0 20px; text-align:center; line-height:1.45;
  font-weight:500;
  max-width:280px;
}
.fire-sub b{
  color:var(--orange);
  font-variant-numeric:tabular-nums;
  font-weight:700;
}

.fire-calendar{
  display:flex; gap:6px;
  width:100%; justify-content:center;
  padding-top:4px;
}
.cal-day{
  flex:1; max-width:44px;
  display:flex; flex-direction:column; align-items:center; gap:5px;
}
.cal-dot{
  width:32px; height:32px; border-radius:50%;
  background:var(--fill);
  display:grid; place-items:center;
  font-size:15px;
  transition:background .3s ease, transform .3s ease;
  border:.5px solid var(--sep);
}
.cal-day.active .cal-dot{
  background:linear-gradient(180deg, #ff9500, #ff3b30);
  border-color:transparent;
  box-shadow:0 4px 12px rgba(255,149,0,.5);
  font-size:16px;
}
.cal-day.today .cal-dot{
  outline:2px solid var(--blue);
  outline-offset:2px;
}
.cal-day span{
  font-size:9.5px; font-weight:600;
  color:var(--text2); text-transform:uppercase; letter-spacing:.3px;
}

.fire-stats{ margin-bottom:16px; }
.fire-stats .stat b{
  background:linear-gradient(90deg, #ff9500, #ff3b30);
  -webkit-background-clip:text; background-clip:text;
  -webkit-text-fill-color:transparent;
}

::-webkit-scrollbar{ width:6px; }
::-webkit-scrollbar-thumb{ background:var(--fill2); border-radius:3px; }
</style>
</head>
<body>

<!-- ================= NAV ================= -->
<header class="nav">
  <div class="nav-inner">
    <div class="brand">
      <div class="logo">
        <img src="logo.png" alt="PAPMA SPORT Logo" />
      </div>
      <h1>PAPMA <span>SPORT</span></h1>
    </div>
    <button class="icon-btn" id="themeBtn" aria-label="Ganti tema"></button>
  </div>
</header>

<main>

  <!-- ================= TIMER ================= -->
  <section class="view active" id="view-timer">
    <div class="card">
      <div class="ring-wrap" id="ringWrap">
        <svg class="ring" viewBox="0 0 240 240">
          <circle class="ring-bg" cx="120" cy="120" r="108"></circle>
          <circle class="ring-fg" id="ringFg" cx="120" cy="120" r="108"></circle>
        </svg>
        <div class="ring-center">
          <div class="time-display" id="timerDisplay">00:00</div>
          <div class="time-sub" id="timerLabel">Siap</div>
        </div>
      </div>

      <div class="time-inputs" id="timeInputs">
        <div class="ti">
          <input type="number" id="tH" value="0" min="0" max="99" inputmode="numeric" />
          <label>Jam</label>
        </div>
        <div class="ti-colon">:</div>
        <div class="ti">
          <input type="number" id="tM" value="0" min="0" max="59" inputmode="numeric" />
          <label>Menit</label>
        </div>
        <div class="ti-colon">:</div>
        <div class="ti">
          <input type="number" id="tS" value="30" min="0" max="59" inputmode="numeric" />
          <label>Detik</label>
        </div>
      </div>

      <div class="chips" id="presetChips">
